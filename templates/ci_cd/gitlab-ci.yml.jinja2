stages:
  - test
  - build
  - deploy

variables:
  PYTHON_VERSION: "{{ python_version }}"
  {% if database == 'postgresql' %}
  POSTGRES_DB: test_db
  POSTGRES_USER: postgres
  POSTGRES_PASSWORD: postgres
  DATABASE_URL: postgresql://postgres:postgres@postgres:5432/test_db
  {% elif database == 'mysql' %}
  MYSQL_ROOT_PASSWORD: mysql
  MYSQL_DATABASE: test_db
  DATABASE_URL: mysql://root:mysql@mysql:3306/test_db
  {% endif %}

{% if 'pytest' in dependencies %}
test:
  stage: test
  image: python:${PYTHON_VERSION}
  services:
    {% if database == 'postgresql' %}
    - postgres:15
    {% elif database == 'mysql' %}
    - mysql:8
    {% elif database == 'mongodb' %}
    - mongo:7
    {% endif %}
    {% if 'redis' in dependencies or 'celery' in dependencies %}
    - redis:7-alpine
    {% endif %}
  before_script:
    - pip install -r requirements.txt
    - pip install pytest pytest-cov
  script:
    - pytest --cov=app --cov-report=xml --cov-report=term
  coverage: '/TOTAL.*\s+(\d+%)$/'
  artifacts:
    reports:
      coverage_report:
        coverage_format: cobertura
        path: coverage.xml
{% endif %}

lint:
  stage: test
  image: python:${PYTHON_VERSION}
  before_script:
    - pip install black isort flake8 mypy
  script:
    - black --check .
    - isort --check-only .
    - flake8 app tests --max-line-length=100 --ignore=E501,W503
    - mypy app --ignore-missing-imports

{% if 'docker' in dependencies or include_docker %}
build-docker:
  stage: build
  image: docker:latest
  services:
    - docker:dind
  before_script:
    - docker login -u $CI_REGISTRY_USER -p $CI_REGISTRY_PASSWORD $CI_REGISTRY
  script:
    - docker build -t $CI_REGISTRY_IMAGE:$CI_COMMIT_SHORT_SHA .
    - docker push $CI_REGISTRY_IMAGE:$CI_COMMIT_SHORT_SHA
    - docker tag $CI_REGISTRY_IMAGE:$CI_COMMIT_SHORT_SHA $CI_REGISTRY_IMAGE:latest
    - docker push $CI_REGISTRY_IMAGE:latest
  only:
    - main
{% endif %}
