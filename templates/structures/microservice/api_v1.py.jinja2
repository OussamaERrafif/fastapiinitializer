@router.get("/ready")
async def readiness_check({% if has_database %}db: Session = Depends(get_db){% endif %}):
    """Service readiness check (for k8s)"""
    {% if has_database %}
    try:
        # Check database connection
        db.execute("SELECT 1")
        return {"status": "ready"}
    except Exception as e:
        {% if has_logging %}
        logger.error("Readiness check failed", exc_info=e)
        {% endif %}
        raise HTTPException(status_code=503, detail="Service not ready")
    {% else %}
    return {"status": "ready"}
    {% endif %}


