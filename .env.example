# FastAPI Project Generator Configuration

# Application Settings
APP_NAME="FastAPI Project Generator"
APP_VERSION="1.0.0"
DEBUG=True
ENVIRONMENT=development

# Server Settings
HOST=localhost
PORT=8000
RELOAD=True

# CORS Settings
CORS_ORIGINS=["*"]
CORS_ALLOW_CREDENTIALS=True
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]

# File Generation Settings
MAX_PROJECT_NAME_LENGTH=50
TEMP_DIR=./temp
CLEANUP_TEMP_FILES=True

# Rate Limiting (optional)
RATE_LIMIT_ENABLED=False
RATE_LIMIT_PER_MINUTE=60

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Security
SECRET_KEY=your-secret-key-here-change-in-production
